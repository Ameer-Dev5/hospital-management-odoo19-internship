<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="appointment_type"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_complete"
                            type="object"
                            string="Complete"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-danger"
                            invisible="state in ('completed', 'cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,completed,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_type"/>
                        </group>

                        <group>
                            <field name="appointment_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_appointment_kanban" model="ir.ui.view">
        <field name="name">hospital.appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="appointment_type"/>
                <field name="priority"/>
                <field name="state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>

                            <div class="mb-1">
                                <strong>Patient:</strong>
                                <field name="patient_id"/>
                            </div>

                            <div class="mb-1">
                                <strong>Doctor:</strong>
                                <field name="doctor_id"/>
                            </div>

                            <div class="mb-1">
                                <strong>Date:</strong>
                                <field name="appointment_date"/>
                            </div>

                            <div class="mb-1">
                                <strong>Type:</strong>
                                <field name="appointment_type" widget="badge"/>
                            </div>

                            <div>
                                <strong>Status:</strong>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hospital_appointment_calendar" model="ir.ui.view">
        <field name="name">hospital.appointment.calendar</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="appointment_date"
                      color="doctor_id"
                      mode="week">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_type"/>
                <field name="state"/>
                <field name="priority" widget="priority"/>
            </calendar>
        </field>
    </record>

    <record id="view_hospital_appointment_activity" model="ir.ui.view">
        <field name="name">hospital.appointment.activity</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <activity string="Appointment Activities">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="state"/>
                <templates>
                    <div t-name="activity-box">
                        <field name="patient_id" display="full"/>
                        <div t-if="record.appointment_date.value" class="text-muted">
                            <field name="appointment_date"/>
                        </div>
                        <div t-if="record.doctor_id.value" class="text-muted">
                            Dr.
                            <field name="doctor_id"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_hospital_appointment_graph" model="ir.ui.view">
        <field name="name">hospital.appointment.graph</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <graph string="Appointment Analysis" type="bar">
                <field name="doctor_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_hospital_appointment_pivot" model="ir.ui.view">
        <field name="name">hospital.appointment.pivot</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Appointment Analysis">
                <field name="doctor_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_type"/>
                <field name="priority"/>
                <field name="state"/>

                <filter name="today_appointments"
                        string="Today's Appointments"
                        domain="[('appointment_date', '>=', 'today'), ('appointment_date', '&lt;', 'today +1d')]"/>

                <filter name="upcoming_appointments"
                        string="Upcoming Appointments"
                        domain="[('appointment_date', '&gt;=', 'now'), ('state', 'not in', ['completed', 'cancelled'])]"/>

                <filter name="completed_appointments"
                        string="Completed Appointments"
                        domain="[('state', '=', 'completed')]"/>

                <separator/>

                <group>
                    <filter name="group_by_doctor"
                            string="Doctor"
                            context="{'group_by': 'doctor_id'}"/>

                    <filter name="group_by_status"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                    <filter name="group_by_type"
                            string="Appointment Type"
                            context="{'group_by': 'appointment_type'}"/>

                    <filter name="group_by_priority"
                            string="Priority"
                            context="{'group_by': 'priority'}"/>

                    <filter name="group_by_date"
                            string="Appointment Date"
                            context="{'group_by': 'appointment_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,kanban,calendar,activity,graph,pivot,form</field>
        <field name="search_view_id" ref="view_hospital_appointment_search"/>
    </record>

    <record id="action_hospital_appointment_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hospital_appointment_list"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_hospital_appointment_kanban"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_hospital_appointment_calendar"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_activity" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">activity</field>
        <field name="view_id" ref="view_hospital_appointment_activity"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_hospital_appointment_graph"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="6"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_hospital_appointment_pivot"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <record id="action_hospital_appointment_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="7"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hospital_appointment_form"/>
        <field name="act_window_id" ref="action_hospital_appointment"/>
    </record>

    <menuitem id="menu_hospital_appointment"
              name="Appointments"
              parent="menu_hospital_root"
              action="action_hospital_appointment"
              sequence="40"/>

</odoo>