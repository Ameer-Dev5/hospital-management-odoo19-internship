<odoo>
    <template id="patient_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2 style="text-align: center;">Hospital Management System</h2>

                    <h3>Patient Information</h3>

                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <td><strong>Patient Name</strong></td>
                                <td><span t-field="doc.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Patient Reference</strong></td>
                                <td><span t-field="doc.ref"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date of Birth</strong></td>
                                <td><span t-field="doc.dob"/></td>
                            </tr>
                            <tr>
                                <td><strong>Age</strong></td>
                                <td><span t-field="doc.age"/></td>
                            </tr>
                            <tr>
                                <td><strong>Gender</strong></td>
                                <td><span t-field="doc.gender"/></td>
                            </tr>
                            <tr>
                                <td><strong>Primary Doctor</strong></td>
                                <td>
                                    <span t-if="doc.doctor_id" t-field="doc.doctor_id"/>
                                    <span t-else="">Not Assigned</span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Status</strong></td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Generated Information</h3>

                    <p>
                        This report contains the current information
                        recorded for the selected patient.
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>