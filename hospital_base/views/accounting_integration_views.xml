<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_consultation_accounting_inherit" model="ir.ui.view">
        <field name="name">hospital.consultation.accounting.inherit</field>
        <field name="model">hospital.consultation</field>
        <field name="inherit_id" ref="hospital_base.view_hospital_consultation_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="before">
                <header>
                    <button
                            name="action_create_invoice"
                            type="object"
                            string="Create Invoice"
                            class="btn-primary"
                    />
                </header>
            </xpath>

            <xpath expr="//form/sheet/group[1]" position="before">
                <div class="oe_button_box" name="invoice_button_box">
                    <button
                            name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                        <field
                                name="invoice_count"
                                widget="statinfo"
                                string="Invoices"
                        />
                    </button>
                </div>
            </xpath>

        </field>
    </record>


    <record id="view_account_move_hospital_inherit" model="ir.ui.view">
        <field name="name">account.move.hospital.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="hospital_patient_id"/>
                <field name="hospital_consultation_id"/>
            </xpath>

        </field>
    </record>

</odoo>