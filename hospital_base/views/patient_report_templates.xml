<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="patient_report_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <div class="page">

                        <div class="text-center mb-4">
                            <h2>Hospital Management System</h2>
                            <h3>Patient Report</h3>
                        </div>

                        <h4>Patient Information</h4>

                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td><strong>Patient Name</strong></td>
                                    <td>
                                        <span t-field="doc.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Patient Reference</strong></td>
                                    <td>
                                        <span t-field="doc.ref"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Date of Birth</strong></td>
                                    <td>
                                        <span t-field="doc.dob"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Age</strong></td>
                                    <td>
                                        <span t-field="doc.age"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Gender</strong></td>
                                    <td>
                                        <span t-field="doc.gender"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Status</strong></td>
                                    <td>
                                        <span t-field="doc.state"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="doc.doctor_id">

                            <h4 class="mt-4">Primary Doctor</h4>

                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <td><strong>Doctor Name</strong></td>
                                        <td>
                                            <span t-field="doc.doctor_id.name"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><strong>Specialization</strong></td>
                                        <td>
                                            <span t-field="doc.doctor_id.specialization"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </t>

                        <t t-if="not doc.doctor_id">

                            <h4 class="mt-4">Primary Doctor</h4>

                            <p>
                                No doctor has been assigned to this patient.
                            </p>

                        </t>

                        <t t-if="doc.doctor_ids">

                            <h4 class="mt-4">Treating Doctors</h4>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Doctor Name</th>
                                        <th>Specialization</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-foreach="doc.doctor_ids" t-as="doctor">
                                        <tr>
                                            <td>
                                                <span t-field="doctor.name"/>
                                            </td>

                                            <td>
                                                <span t-field="doctor.specialization"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </t>

                        <t t-if="not doc.doctor_ids">

                            <h4 class="mt-4">Treating Doctors</h4>

                            <p>
                                No treating doctors are associated with this patient.
                            </p>

                        </t>

                        <h4 class="mt-4">Generated Information</h4>

                        <p>
                            This report contains the current information
                            recorded for the selected patient.
                        </p>

                    </div>

                </t>

            </t>

        </t>
    </template>

</odoo>