<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_hospital_patient_manager" model="ir.rule">
        <field name="name">Managers: All Patients</field>
        <field name="model_id" ref="model_hospital_patient"/>
        <field name="groups" eval="[(4, ref('hospital_base.group_hospital_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="hospital_appointment_portal_rule" model="ir.rule">
        <field name="name">Portal users: own appointments</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('patient_id.partner_id', '=', user.partner_id.id)]
        </field>
    </record>

    <record id="rule_hospital_patient_multi_company" model="ir.rule">
        <field name="name">Hospital Patient: Multi-company</field>
        <field name="model_id" ref="model_hospital_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hospital_doctor_multi_company" model="ir.rule">
        <field name="name">Hospital Doctor: Multi-company</field>
        <field name="model_id" ref="model_hospital_doctor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hospital_appointment_multi_company" model="ir.rule">
        <field name="name">Hospital Appointment: Multi-company</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hospital_consultation_multi_company" model="ir.rule">
        <field name="name">Hospital Consultation: Multi-company</field>
        <field name="model_id" ref="model_hospital_consultation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>