<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_billing_list" model="ir.ui.view">
        <field name="name">hospital.billing.list</field>
        <field name="model">hospital.billing</field>
        <field name="arch" type="xml">
            <list string="Bills">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="billing_date"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_billing_form" model="ir.ui.view">
        <field name="name">hospital.billing.form</field>
        <field name="model">hospital.billing</field>
        <field name="arch" type="xml">
            <form string="Bill">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_paid"
                            type="object"
                            string="Mark Paid"
                            invisible="state != 'confirmed'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state == 'paid' or state == 'cancelled'"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="patient_id"/>
                        <field name="billing_date"/>
                        <field name="amount_total" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Bill Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_billing" model="ir.actions.act_window">
        <field name="name">Billing</field>
        <field name="res_model">hospital.billing</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>